<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>de6a4acc-2cac-4706-9aad-aa07d4807396</UserSecretsId>
    <Version>0.2.20</Version>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RigMD.Application\RigMD.Application.csproj" />
    <ProjectReference Include="..\RigMD.Infrastructure\RigMD.Infrastructure.csproj" />
  </ItemGroup>

  <!-- A distinct process name keeps crash cleanup from confusing an active uninstall helper with an orphan API. -->
  <Target Name="CopyRegisteredUninstallHelper" AfterTargets="Build" Condition="Exists('$(TargetDir)RigMD.Api.exe')">
    <Copy SourceFiles="$(TargetDir)RigMD.Api.exe" DestinationFiles="$(TargetDir)RigMD.Uninstall.exe" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishRegisteredUninstallHelper" AfterTargets="Publish" Condition="Exists('$(PublishDir)RigMD.Api.exe')">
    <Copy SourceFiles="$(PublishDir)RigMD.Api.exe" DestinationFiles="$(PublishDir)RigMD.Uninstall.exe" SkipUnchangedFiles="true" />
  </Target>

</Project>
