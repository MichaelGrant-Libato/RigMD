<Window x:Class="RigMD.Desktop.ExitConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exit RigMD?" Width="412" MinWidth="280" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" Foreground="#F8FAFC" UseLayoutRounding="True"
        PreviewKeyDown="Dialog_PreviewKeyDown" Closing="Dialog_Closing"
        AutomationProperties.Name="Exit RigMD confirmation">
    <Window.Resources>
        <DataTemplate x:Key="ButtonLabel">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
        </DataTemplate>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ContentTemplate" Value="{StaticResource ButtonLabel}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#E0FAFF" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseFrame" Background="Transparent" CornerRadius="14"
                                BorderBrush="Transparent" BorderThickness="1">
                            <Path Data="M 0,0 L 9,9 M 0,9 L 9,0" Width="9" Height="9"
                                  Stroke="#94A3B8" StrokeThickness="1.6"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseFrame" Property="Background" Value="#1D3040" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseFrame" Property="BorderBrush" Value="#67E8F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Border x:Name="Card" Background="#101B28" BorderBrush="#2D4656" BorderThickness="1"
                CornerRadius="20" Padding="24,16,24,24" RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" />
                    <TranslateTransform x:Name="CardSlide" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Style="{StaticResource CloseButtonStyle}" HorizontalAlignment="Right"
                        ToolTip="Cancel exit" AutomationProperties.Name="Cancel exit" Click="Stay_Click" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Viewbox x:Name="ExitIllustration" Width="174" Height="140" HorizontalAlignment="Center" Margin="0,0,0,14"
                                 AutomationProperties.Name="A person leaving through a doorway">
                            <Canvas Width="200" Height="162">
                                <Ellipse Canvas.Left="39" Canvas.Top="16" Width="136" Height="137" Fill="#122A37" />
                                <Ellipse Canvas.Left="27" Canvas.Top="142" Width="151" Height="13" Fill="#1F3845" />
                                <Path Data="M 72,30 L 124,12 L 142,22 L 142,145 L 72,145 Z" Fill="#254B59" />
                                <Path Data="M 82,31 L 132,16 L 132,144 L 82,144 Z" Fill="#163945" />
                                <Path Data="M 88,37 L 124,26 L 124,79 L 88,83 Z M 88,91 L 124,88 L 124,133 L 88,133 Z"
                                      Stroke="#3FBCCC" StrokeThickness="2" />
                                <Ellipse Canvas.Left="118" Canvas.Top="86" Width="4" Height="4" Fill="#99F6E4" />
                                <Path Data="M 51,140 Q 51,117 43,113 M 52,137 Q 57,121 65,121 M 51,130 Q 42,124 39,124"
                                      Stroke="#3B7381" StrokeThickness="2.5" />
                                <Path Data="M 43,116 Q 30,106 40,104 Q 51,105 46,121 M 55,131 Q 60,116 70,119 Q 73,130 55,133 M 47,130 Q 31,131 34,121 Q 41,118 47,130"
                                      Fill="#2DD4BF" />
                                <Path Data="M 40,137 L 62,137 L 58,154 L 44,154 Z" Fill="#315364" />
                                <Ellipse Canvas.Left="143" Canvas.Top="43" Width="16" Height="20" Fill="#EBC1AC" />
                                <Path Data="M 142,53 Q 136,41 146,38 Q 160,36 162,47 L 154,48 L 151,44 L 149,53 Z" Fill="#94A3B8" />
                                <Path Data="M 145,65 Q 153,61 160,69 L 169,91 L 157,97 L 147,80 L 140,93 L 132,88 Z" Fill="#22D3EE" />
                                <Path Data="M 139,78 L 131,87 L 123,88" Stroke="#EBC1AC" StrokeThickness="5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="M 146,94 L 159,95 L 156,119 L 170,141 L 160,145 L 146,125 L 143,111 L 135,139 L 125,136 L 135,101 Z"
                                      Fill="#7D9DAA" />
                                <Path Data="M 125,137 L 121,144 L 135,144 M 161,145 L 172,145 L 169,140"
                                      Stroke="#A7C3CE" StrokeThickness="4" StrokeStartLineCap="Round" />
                                <Path Data="M 170,53 L 174,47 M 175,60 L 182,58 M 166,44 L 166,39"
                                      Stroke="#67E8F9" StrokeThickness="2" StrokeStartLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="Heading" Text="Exit RigMD?" FontSize="22" FontWeight="Bold"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock x:Name="Explanation" FontSize="13" Foreground="#A9B9C9"
                                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="21"
                                   Text="Running checks and actions will stop. Your saved checks will be here when you return." />
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="ButtonRow" Grid.Row="2" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="StayButton" Style="{StaticResource PillButton}" Grid.Column="0"
                            Content="Cancel" IsDefault="True" Margin="0,0,6,0"
                            Background="#162331" BorderBrush="#334B5A" Foreground="#DBE7F0" Click="Stay_Click" />
                    <Button x:Name="ExitButton" Style="{StaticResource PillButton}" Grid.Column="1"
                            Content="Exit RigMD" Margin="6,0,0,0" Background="#22D3EE"
                            BorderBrush="#22D3EE" Foreground="#041014" Click="Exit_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
