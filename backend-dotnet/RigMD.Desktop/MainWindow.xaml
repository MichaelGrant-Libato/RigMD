<Window x:Class="RigMD.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RigMD" Height="768" Width="1024" WindowStartupLocation="CenterScreen"
        Background="#070C12"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Storyboard x:Key="StartupActivityMotion" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="NativeActivitySegment"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-64" To="240" Duration="0:0:1.8" />
        </Storyboard>
        <Style x:Key="ZoomButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="Background" Value="#15222D" />
            <Setter Property="BorderBrush" Value="#304451" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#00C4DE" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#00C4DE" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Name="ZoomToolbar" Visibility="Collapsed" Background="#0D151E"
                BorderBrush="#304451" BorderThickness="0,0,0,1" Padding="6,3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="ZoomOutButton" Style="{StaticResource ZoomButton}" Content="-"
                        AutomationProperties.Name="Zoom out" ToolTip="Zoom out (Ctrl+-)"
                        Click="ZoomOut_Click" />
                <Button Name="ZoomResetButton" Style="{StaticResource ZoomButton}" Content="100%"
                        Width="60" FontSize="12" AutomationProperties.Name="Reset zoom to 100 percent"
                        ToolTip="Reset zoom to 100% (Ctrl+0)" Click="ZoomReset_Click" />
                <Button Name="ZoomInButton" Style="{StaticResource ZoomButton}" Content="+"
                        AutomationProperties.Name="Zoom in" ToolTip="Zoom in (Ctrl++)"
                        Click="ZoomIn_Click" />
            </StackPanel>
        </Border>
        <Grid Name="NativeStartupSplash" Grid.Row="1" Background="#070C12"
              AutomationProperties.Name="Getting RigMD ready">
            <StackPanel Width="400" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="320" Height="156" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <Canvas Width="320" Height="156">
                        <Path Data="M18 54 H62 L82 74 H116 M18 102 H62 L82 82 H116 M204 74 H238 L258 54 H302 M204 82 H238 L258 102 H302 M142 12 V34 M160 12 V34 M178 12 V34 M142 122 V144 M160 122 V144 M178 122 V144" Stroke="#294451" StrokeThickness="1" />
                        <Rectangle Canvas.Left="116" Canvas.Top="34" Width="88" Height="88"
                                   RadiusX="12" RadiusY="12" Stroke="#294451" StrokeThickness="1" />
                        <Path Data="M106 54 H116 M106 66 H116 M106 90 H116 M106 102 H116 M204 54 H214 M204 66 H214 M204 90 H214 M204 102 H214" Stroke="#294451" StrokeThickness="1" />
                    </Canvas>
                    <Image Width="64" Height="64" Stretch="Uniform"
                           Source="pack://application:,,,/RigMD.Desktop;component/Assets/rigmd-logo.png"
                           AutomationProperties.Name="RigMD logo" />
                </Grid>
                <TextBlock Text="RigMD" FontSize="32" FontWeight="SemiBold" Foreground="#F1F5F9"
                           HorizontalAlignment="Center" Margin="0,16,0,7" />
                <TextBlock Text="Windows diagnostic support" FontSize="13" Foreground="#91A4B5"
                           HorizontalAlignment="Center" />
                <Grid Width="240" Height="2" Background="#1C2D3A" ClipToBounds="True" Margin="0,32,0,16">
                    <Rectangle Name="NativeActivitySegment" Width="64" Height="2" Fill="#2DD4BF"
                               HorizontalAlignment="Left" IsHitTestVisible="False">
                        <Rectangle.RenderTransform><TranslateTransform X="88" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
                <TextBlock Name="LoadingText" Text="Starting RigMD…" FontSize="13" Foreground="#B2C2CF"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <wv2:WebView2 Name="Browser" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
</Window>
