# ============================================================
#  RigMD .gitignore
#  React + FastAPI + PostgreSQL (Supabase)
# ============================================================

# SECRETS — never commit these
.env
.env.*
!.env.example
secrets.py
config.ini

# FRONTEND — React / Node
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.eslintcache

# BACKEND — Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
venv/
env/
.venv/
backend/venv/
backend/.venv/
*.egg
*.egg-info/
dist/
build/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# ALEMBIC
database/migrations/versions/*.pyc

# IDE
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
*.DS_Store
Thumbs.db
desktop.ini

# LOGS
*.log
logs/

# MISC
*.bak
*.tmp
test_results/