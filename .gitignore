# ============================================================
# RigMD .gitignore
# React + C#/.NET + Legacy Python + PostgreSQL/Supabase
# ============================================================


# ============================================================
# SECRETS / ENVIRONMENT FILES
# Never commit real credentials, API keys, DB URLs, or tokens
# ============================================================

.env
.env.*

backend/.env
backend/.env.*

frontend/.env
frontend/.env.*

# Keep safe sample environment files
!.env.example
!backend/.env.example
!frontend/.env.example

secrets.py
config.ini
*.key
*.pem
*.crt


# ============================================================
# FRONTEND — React / Vite / Node
# ============================================================

frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.eslintcache

# Keep package files tracked
!frontend/package-lock.json
!frontend/package.json


# ============================================================
# C# / .NET
# ============================================================

**/bin/
**/obj/

*.suo
*.user
*.userosscache
*.sln.docstates

TestResults/
test_results/

*.coverage
*.coveragexml


# ============================================================
# LEGACY BACKEND — Python / FastAPI
# Retained temporarily for migration/reference purposes
# ============================================================

__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

venv/
env/
.venv/

backend/venv/
backend/env/
backend/.venv/

*.egg
*.egg-info/

.mypy_cache/
.pytest_cache/
.coverage
htmlcov/


# ============================================================
# DATABASE / MIGRATIONS
# ============================================================

database/migrations/versions/*.pyc
backend/database/migrations/versions/*.pyc

*.db
*.db-shm
*.db-wal


# ============================================================
# IDE / EDITOR FILES
# ============================================================

.vscode/
.idea/

*.swp
*.swo


# ============================================================
# OS FILES
# ============================================================

.DS_Store
Thumbs.db
desktop.ini


# ============================================================
# LOGS
# ============================================================

*.log
logs/
backend/logs/
frontend/logs/


# ============================================================
# TEMP / BACKUP FILES
# ============================================================

*.bak
*.tmp
*.temp
*.old


# ============================================================
# LOCAL TESTING / CACHE / DRAFT DOCS
# ============================================================

.cache/
coverage/
README_V2.md
# Local developer secrets - never commit
backend-dotnet/RigMD.Api/appsettings.Development.json
installer/output/
